# Local: http://127.0.0.1:8000/api. Vercel: HTTPS del backend terminado en /api.
# La ruta /api solo sirve si se configura expresamente un proxy en el mismo sitio.
VITE_API_URL=http://127.0.0.1:8000/api
# En Vercel siempre false. La demostración solo funciona en loopback.
VITE_DEMO_MODE=false
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Solo publishable o anon. Nunca service_role ni sb_secret_ ni contraseña de BD.
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Alternativa pública para migrar a otro proyecto en Vercel: configurar ambas.
# Tienen prioridad sobre VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY.
# VITE_SUPABASE_PROJECT_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
